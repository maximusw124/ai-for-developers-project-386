{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "ignore": [
      "node_modules",
      ".e2e",
      "dist",
      ".github",
      "contract/openapi",
      "backend/src/api/generated",
      "frontend/src/api/generated",
      "playwright-report",
      "test-results"
    ]
  }
}
